# Base URL of the FastAPI backend (Phase 2).
VITE_API_BASE_URL=http://localhost:8000

# false = fetch live from the backend above (requires it to be running).
# true  = use the captured mock fixtures in src/api/mockData instead
#         (useful for offline demoing; filters won't change the numbers
#         since a fixture is a single static snapshot).
VITE_USE_MOCK=false
